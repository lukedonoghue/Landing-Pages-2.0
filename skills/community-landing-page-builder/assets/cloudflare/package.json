{
  "name": "branded-lead-funnel",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "wrangler dev --ip 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:check": "node scripts/preflight.mjs",
    "deploy": "node scripts/publish.mjs",
    "deploy:dry": "wrangler deploy --dry-run",
    "github": "node scripts/github.mjs",
    "configure": "node scripts/sync-config.mjs",
    "publish": "node scripts/publish.mjs",
    "qa:performance": "node scripts/performance-audit.mjs",
    "qa:browsers": "node scripts/browser-compat.mjs",
    "verify:live": "node scripts/live-verify.mjs",
    "admin": "node scripts/admin-account.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "wrangler": "4.115.0",
    "miniflare": "4.20260722.1",
    "playwright-core": "1.63.0",
    "esbuild": "0.25.12",
    "lighthouse": "13.4.1",
    "chrome-launcher": "1.2.1"
  },
  "overrides": {
    "@sentry/node": "10.74.0",
    "@sentry/core": "10.74.0",
    "miniflare": {
      "undici": "7.29.0",
      "sharp": "0.35.4"
    }
  }
}
