{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookkeeping-by-beks-demo-20260921-r1",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookkeeping-by-beks-demo-20260921-r1-crm",
      "database_id": "5b58bbdd-4ac4-48fa-8864-307782c50887",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "account_id": "5b93d5e3c469e05d9bd13672e7887c4a"
}
